[Unit]
Description=Claude PR Event Channel — dispatcher and webhook forwarders
Documentation=https://github.com/denniscual0217/claude-pr-channel
After=network-online.target
Wants=network-online.target

[Service]
# `up` starts detached processes and returns, so the unit records that it ran rather
# than supervising a foreground process. The forwarder has its own supervisor.
Type=oneshot
RemainAfterExit=yes
Environment=HOME=__HOME__
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
User=__USER__
ExecStart=__ROOT__/bin/pr-channel boot
ExecStop=__ROOT__/bin/pr-channel stop
TimeoutStartSec=180

[Install]
WantedBy=multi-user.target
